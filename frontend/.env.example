# Backend API URL
# You can use either format - the code will automatically append /api if needed:

# Format 1: Just the domain (recommended)
VITE_API_URL=https://smart-crick-pro.onrender.com

# Format 2: With /api path (also works)
# VITE_API_URL=https://smart-crick-pro.onrender.com/api

# Local development
# VITE_API_URL=http://localhost:5000
